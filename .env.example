# ===================================
# SAGE-API - Variáveis de Ambiente
# ===================================
# Copie para .env e configure suas credenciais

# Diretórios do instalador (use caminhos absolutos; obrigatório em produção para não gravar no release)
SAGE_DATA_DIR=C:\ProgramData\SAGE
# SAGE_CONFIG_FILE=C:\ProgramData\SAGE\config\sage.env

# Servidor
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_mysql_aqui
DB_NAME=sage
DB_TIMEZONE=-03:00
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100

# Redis - Cache e Sessoes
REDIS_ENABLED=false
REDIS_PORT=6379
REDIS_DB=0

# JWT Autenticação (gere uma chave forte com pelo menos 32 caracteres aleatórios)
# Exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ALTERE_ESTA_CHAVE_SECRETA_COM_MINIMO_32_CARACTERES_ALEATORIOS
JWT_EXPIRES_IN=1h

# Bootstrap de primeira instalação. O instalador gera esses valores e os remove do ambiente após
# o setup. Em upgrades, eles são ignorados e a credencial existente nunca é redefinida.
# SAGE_INITIAL_ADMIN_LOGIN=
# SAGE_INITIAL_ADMIN_PASSWORD=
# SAGE_INITIAL_SCHOOL_NAME=

# CORS (lista de domínios permitidos, separados por vírgula)
# IMPORTANTE: Em produção, NUNCA adicione https://editor.swagger.io
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Control iD (Catraca)
CATRACA_TIMEOUT=10000
CATRACA_RETRY_ATTEMPTS=3
CATRACA_RETRY_DELAY=1000
CATRACA_RETRY_DELAY_1_MS=2000
CATRACA_RETRY_DELAY_2_MS=5000
CATRACA_RETRY_DELAY_3_MS=10000
# Timeout só para load_objects (access_logs). A API não filtra na origem: a catraca envia TODOS os logs.
# Com milhares de logs, 10s pode dar timeout. Padrão 60s. Aumente (ex.: 90000) se ainda estourar.
CATRACA_LOAD_LOGS_TIMEOUT=60000
CATRACA_BACKUP_CHUNK_SIZE=2000
CATRACA_LOGS_INFO_THRESHOLD=5000
# Após gerar backup, esperar N ms antes de chamar destroy_objects (evita 503 por sobrecarga). Padrão 15000 (15s).
CATRACA_DELAY_APOS_BACKUP_MS=15000
# Timeout só para destroy_objects (zerar logs). Catraca pode demorar 1–3 min para apagar 70k+ registros. Padrão 180000 (3 min).
CATRACA_ZERAR_LOGS_TIMEOUT_MS=180000
# Offset para user_id na catraca: catracaUserId = CATRACA_USER_ID_OFFSET + pessoa.id
# Deve ser o mesmo em criação (controlIdService) e sincronização (accessService). Padrão: 111000000
# CATRACA_USER_ID_OFFSET=111000000

# Sentido do giro da catraca → entrada/saída. Na catraca Control iD o giro é detectado por portal:
# normalmente giro à esquerda = entrada (portal 1), giro à direita = saída (portal 2). Ajuste se no equipamento estiver invertido.
# CATRACA_ENTRADA_PORTAL_ID=1
# CATRACA_SAIDA_PORTAL_ID=2

# Catracas antigas (só QR/RFID/senha, sem módulo facial): não tente enviar foto na edição de pessoa.
# CATRACA_SKIP_USER_IMAGE=true

# Ignorar logs antigos: só processar logs com id > CATRACA_MIN_LOG_ID.
# Padrão seguro: 0 (não filtra por id). Se definir um valor alto (ex.: 73975), TODOS os logs
# podem ser descartados se a catraca usar IDs menores (ex.: id por dispositivo). Use só após
# confirmar no log "[SYNC] ... diagnóstico catraca → id [min, max]" a faixa real de IDs.
# CATRACA_MIN_LOG_ID=0

# Monitor Control iD - duas formas de ver acessos em tempo (quase) real:
#
# 1) POLLING (recomendado, igual ao software oficial Control iD): o servidor consulta as catracas
#    a cada X segundos. Não precisa abrir firewall nem a catraca enviar POST.
#    MONITOR_POLLING_INTERVAL_MS=20000   (20 s; entre 1000 e 3600000 ms). Use 10000 (10 s) para atualizar mais rápido.
#
# 2) PUSH (Monitor): a catraca envia POST para este servidor. Requer MONITOR_CALLBACK_* e firewall.
# Se o cliente NÃO abrir a porta, use apenas polling: deixe MONITOR_USE_PUSH=false (ou não defina).
# MONITOR_USE_PUSH=true   = configurar callback na catraca (push); requer MONITOR_CALLBACK_* e porta aberta.
# MONITOR_USE_PUSH=false = só polling (servidor consulta a catraca); não precisa abrir porta.
MONITOR_USE_PUSH=false
MONITOR_POLLING_INTERVAL_MS=20000
MONITOR_CALLBACK_HOST=192.168.0.64
MONITOR_CALLBACK_PORT=3000
MONITOR_MAX_EVENT_AGE_SECONDS=300
MONITOR_SYNC_LIMIT=200
# MONITOR_CALLBACK_URL=192.168.0.64:3000

# Segurança do callback Monitor (recomendado em produção):
# Token compartilhado obrigatório: o callback pode enviar X-Monitor-Token (preferido) ou ?token=.
MONITOR_CALLBACK_TOKEN=CHAVE_ULTRA_SECRETA_GERE_UMA_LONGA
# Whitelist de IP: obrigatória com MONITOR_USE_PUSH=true; opcional em polling.
# MONITOR_IP_WHITELIST=192.168.0.101,192.168.0.102
# Idade máxima do evento (segundos): descarta eventos mais antigos (proteção replay). Padrão 300 (5 min).

# Sincronização com Catracas
# CATRACA_SYNC_ENABLED=true | false — Desabilita TODOS os jobs de sincronização com catracas
# (sync de acessos, polling monitor, sync pendentes, health check, sync no boot). Útil para
# pausar temporariamente e liberar o sistema para outras melhorias. Padrão: true
# CATRACA_SYNC_ENABLED=true
SYNC_CHECK_INTERVAL=*/5 * * * *
SYNC_BATCH_SIZE=50
SYNC_PARALLEL_LIMIT=3
SYNC_PASSO_PONTEIRO=25

# Health Check de Catracas
HEALTH_CHECK_INTERVAL=60000

# Limites HTTP e WebSocket (milissegundos, exceto UPLOAD_MAX_SIZE_MB)
REQUEST_TIMEOUT=30000
IMPORT_TIMEOUT_MS=300000
UPLOAD_MAX_SIZE_MB=25
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=60000

# Promoção automática de alunos (verifica se ano mudou e promove 1º→2º→3º ou finaliza)
# Formato cron: minuto hora dia mês dia_semana. PC desligado à meia-noite? Use horário em que esteja ligado.
# Ex.: "10 8 * * *" = 08:10 | "0 7 * * *" = 07:00 | "30 18 * * 1-5" = 18:30 seg-sex | vazio = desabilita
PROMOCAO_CRON=false
# Desabilitar promoção na subida do servidor (evita finalizar todos se turmas 2º/3º ainda não existirem)
# PROMOCAO_NA_SUBIDA=false

# API Version
API_VERSION=1.0.0

# Recuperação de senha (esqueci a senha) — envio de e-mail
# Configure SMTP para ativar. Ex.: Gmail: host smtp.gmail.com, port 587, user seu@gmail.com, pass "senha de app"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@sage.local
# URL do frontend (para o link de redefinir senha no e-mail). Ex.: http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ─── Backup do banco (Fase 2, E4) ──────────────────────────────────────────────
# "Backup não verificado não é backup": além de gerar, o sistema RESTAURA o arquivo
# num banco temporário e confere as contagens. Verificar é caro (restaura tudo);
# num HD mecânico isso pesa, mas o padrão é verificar — arquivo que ninguém nunca
# restaurou é promessa, não garantia.
BACKUP_CRON=0 3 * * *
# Se o último backup tiver mais que isto (horas), roda na subida. Necessário porque
# o PC da escola é desligado e o horário agendado pode nunca chegar.
BACKUP_MAX_HORAS=24
BACKUP_DIR=
BACKUP_RETER_DIAS=14
# Nunca apaga além disso, mesmo se todos parecerem velhos (protege contra relógio errado)
BACKUP_RETER_MINIMO=3
# BACKUP_VERIFICAR=false desliga a restauração de verificação (NÃO recomendado)
# Caminhos dos binários — no Windows o instalador conhece o MySQL que ele instalou
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
# MYSQL_PATH=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysql.exe

# Espera pelo schema no boot (tentativas e milissegundos)
SAGE_RUNTIME_SCHEMA_RETRY_ATTEMPTS=10
SAGE_RUNTIME_SCHEMA_RETRY_DELAY_MS=3000
