# ===================================
# SAGE-API - Variáveis de Ambiente
# ===================================
# Copie para .env e configure suas credenciais

# Servidor
NODE_ENV=production
PORT=3000

# Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_mysql_aqui
DB_NAME=sage

# JWT Autenticação (gere uma chave forte)
JWT_SECRET=ALTERE_ESTA_CHAVE_SECRETA_COM_MINIMO_32_CARACTERES_ALEATORIOS

# CORS (opcional - adicione domínios permitidos separados por vírgula)
# CORS_ORIGINS=https://seudominio.com,https://app.seudominio.com

