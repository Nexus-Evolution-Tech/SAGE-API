# SAGE-API Environment Variables Template
# Copy this file to .env and fill in with your values
# NEVER commit .env to Git!

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=douglas
DB_NAME=sage
DB_TIMEZONE=-03:00

# Server Configuration
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRE=10m

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://editor.swagger.io

# Features
CATRACA_ENABLED=false

# Sync Configuration (Future)
SYNC_ENABLED=false
SYNC_SERVER=
SYNC_API_KEY=
