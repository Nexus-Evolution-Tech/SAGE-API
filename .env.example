# ===================================
# SAGE-API - Variáveis de Ambiente
# ===================================
# Copie para .env e configure suas credenciais

# Servidor
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_mysql_aqui
DB_NAME=sage
DB_TIMEZONE=-03:00
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100

# Redis - Cache e Sessoes
REDIS_ENABLED=false

# JWT Autenticação (gere uma chave forte com pelo menos 32 caracteres aleatórios)
# Exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ALTERE_ESTA_CHAVE_SECRETA_COM_MINIMO_32_CARACTERES_ALEATORIOS
JWT_EXPIRES_IN=1h

# CORS (lista de domínios permitidos, separados por vírgula)
# IMPORTANTE: Em produção, NUNCA adicione https://editor.swagger.io
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Control iD (Catraca)
CATRACA_TIMEOUT=10000
CATRACA_RETRY_ATTEMPTS=3
CATRACA_RETRY_DELAY=1000
# Timeout só para load_objects (access_logs). A API não filtra na origem: a catraca envia TODOS os logs.
# Com milhares de logs, 10s pode dar timeout. Padrão 60s. Aumente (ex.: 90000) se ainda estourar.
CATRACA_LOAD_LOGS_TIMEOUT=60000
# Offset para user_id na catraca: catracaUserId = CATRACA_USER_ID_OFFSET + pessoa.id
# Deve ser o mesmo em criação (controlIdService) e sincronização (accessService). Padrão: 111000000
# CATRACA_USER_ID_OFFSET=111000000

# Catracas antigas (só QR/RFID/senha, sem módulo facial): não tente enviar foto na edição de pessoa.
# CATRACA_SKIP_USER_IMAGE=true

# Ignorar logs antigos: só processar logs com id > CATRACA_MIN_LOG_ID.
# Padrão seguro: 0 (não filtra por id). Se definir um valor alto (ex.: 73975), TODOS os logs
# podem ser descartados se a catraca usar IDs menores (ex.: id por dispositivo). Use só após
# confirmar no log "[SYNC] ... diagnóstico catraca → id [min, max]" a faixa real de IDs.
# CATRACA_MIN_LOG_ID=0

# Monitor Control iD - duas formas de ver acessos em tempo (quase) real:
#
# 1) POLLING (recomendado, igual ao software oficial Control iD): o servidor consulta as catracas
#    a cada X segundos. Não precisa abrir firewall nem a catraca enviar POST.
#    MONITOR_POLLING_INTERVAL_MS=20000   (20 s; 0 = desliga). Use 10000 (10 s) para atualizar mais rápido.
#
# 2) PUSH (Monitor): a catraca envia POST para este servidor. Requer MONITOR_CALLBACK_* e firewall.
# Se o cliente NÃO abrir a porta, use apenas polling: deixe MONITOR_USE_PUSH=false (ou não defina).
# MONITOR_USE_PUSH=true   = configurar callback na catraca (push); requer MONITOR_CALLBACK_* e porta aberta.
# MONITOR_USE_PUSH=false = só polling (servidor consulta a catraca); não precisa abrir porta.
MONITOR_USE_PUSH=false
MONITOR_POLLING_INTERVAL_MS=20000
MONITOR_CALLBACK_HOST=192.168.0.64
MONITOR_CALLBACK_PORT=3000
# MONITOR_CALLBACK_URL=192.168.0.64:3000

# Segurança do callback Monitor (recomendado em produção):
# Token compartilhado: a catraca envia ?token=CHAVE na URL; o servidor só aceita se bater.
# MONITOR_CALLBACK_TOKEN=CHAVE_ULTRA_SECRETA_GERE_UMA_LONGA
# Whitelist de IP: só aceitar POST do callback se o IP da catraca estiver na lista (vírgula).
# MONITOR_IP_WHITELIST=192.168.0.101,192.168.0.102
# Idade máxima do evento (segundos): descarta eventos mais antigos (proteção replay). Padrão 300 (5 min).
# MONITOR_MAX_EVENT_AGE_SECONDS=300

# Sincronização com Catracas
SYNC_CHECK_INTERVAL=*/5 * * * *
SYNC_BATCH_SIZE=50

# Health Check de Catracas
HEALTH_CHECK_INTERVAL=60000

# Promoção automática de alunos (verifica se ano mudou e promove 1º→2º→3º ou finaliza)
# Formato cron: minuto hora dia mês dia_semana. PC desligado à meia-noite? Use horário em que esteja ligado.
# Ex.: "10 8 * * *" = 08:10 | "0 7 * * *" = 07:00 | "30 18 * * 1-5" = 18:30 seg-sex | vazio = desabilita
PROMOCAO_CRON="10 8 * * *"

# API Version
API_VERSION=1.0.0

# Recuperação de senha (esqueci a senha) — envio de e-mail
# Configure SMTP para ativar. Ex.: Gmail: host smtp.gmail.com, port 587, user seu@gmail.com, pass "senha de app"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@sage.local
# URL do frontend (para o link de redefinir senha no e-mail). Ex.: http://localhost:3001
FRONTEND_URL=http://localhost:3001
